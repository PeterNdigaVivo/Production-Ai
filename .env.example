# ---- Database ----
POSTGRES_USER=production_ai
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=production_ai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://production_ai:change-me-in-prod@postgres:5432/production_ai

# ---- TimescaleDB (separate instance, may be same as postgres in dev) ----
TIMESCALE_URL=postgresql+asyncpg://production_ai:change-me-in-prod@timescaledb:5432/production_ai_ts

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_FRAMES=stream:frames
REDIS_STREAM_DETECTIONS=stream:detections
REDIS_STREAM_TRACKS=stream:tracks
REDIS_STREAM_EVENTS=stream:events

# ---- Auth ----
JWT_SECRET=replace-with-a-32+byte-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- Detection ----
YOLO_MODEL_PATH=/models/yolo11n.pt
YOLO_DEVICE=cuda:0      # set to "cpu" to force CPU
YOLO_HALF=true
DETECTION_CONFIDENCE=0.35
DETECTION_IOU=0.5
DETECTION_TARGET_FPS=8

# ---- Tracking ----
TRACKER=bytetrack       # bytetrack | botsort

# ---- Ingestion ----
INGEST_HW_ACCEL=auto    # auto | cuda | qsv | none
INGEST_TRANSPORT=tcp    # tcp | udp
INGEST_TARGET_FPS=8

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://mlflow:5000

# ---- Observability ----
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ---- Alerting (optional channels) ----
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_WHATSAPP_TOKEN=
ALERT_WEBHOOK_URL=
